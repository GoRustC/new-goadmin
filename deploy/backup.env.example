# Settings for ginadmin-backup.sh. Copy to /etc/ginadmin/backup.env (chmod 600).
DB_TYPE=mysql
DB_NAME=ginadmin
# If you change this, change ReadWritePaths in ginadmin-backup.service too.
BACKUP_DIR=/var/backups/ginadmin
KEEP_DAYS=14

# PostgreSQL only: connection for pg_dump. The password goes in /root/.pgpass
# (chmod 600), one line: 127.0.0.1:5432:ginadmin:ginadmin:PASSWORD
#PGHOST=127.0.0.1
#PGUSER=ginadmin

# Optional: a command that copies each new backup to another machine; it gets
# the file path as $1. A backup on the same disk is lost with that disk.
#AFTER_BACKUP=/usr/local/bin/ginadmin-backup-upload
