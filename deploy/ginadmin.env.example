# Environment for configs/prod. Copy to /etc/ginadmin/ginadmin.env,
# chmod 600, owned by root. Values are used verbatim: no quoting needed.

# Required
GINADMIN_DB_DSN=ginadmin:CHANGE_ME@tcp(127.0.0.1:3306)/ginadmin?charset=utf8mb4&parseTime=True&loc=Local&timeout=5s&readTimeout=30s&writeTimeout=30s
GINADMIN_REDIS_ADDR=127.0.0.1:6379
# At least 32 bytes, e.g. from: openssl rand -hex 32
GINADMIN_JWT_KEY=CHANGE_ME
# bcrypt hash of the root password, from: printf '%s' 'your-root-password' | ./ginadmin hash-password
# Leave empty to disable the root account.
GINADMIN_ROOT_PASSWORD=CHANGE_ME

# Optional
#GINADMIN_DB_TYPE=postgres
#GINADMIN_HTTP_ADDR=127.0.0.1:8040
#GINADMIN_REDIS_USERNAME=
#GINADMIN_REDIS_PASSWORD=
# Password (MD5) for new users created without one and for resets; empty disables both.
#GINADMIN_DEFAULT_LOGIN_PWD=
# Prometheus metrics at /metrics, default 127.0.0.1:8041; empty disables them.
# Use a private address if Prometheus runs on another host; never a public one.
#GINADMIN_METRICS_ADDR=127.0.0.1:8041
